# Variables de Entorno - Frontend Financiera Sol Perú
# NUNCA incluyas claves secretas o privadas aquí. Solo prefijos NEXT_PUBLIC_

# Clave de Sitio de Cloudflare Turnstile (Site Key pública)
# Clave de prueba oficial de Cloudflare que siempre aprueba: 1x00000000000000000000AA
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# URL base del API Backend seguro (ejemplo: https://api.solperu.pe)
# Si se deja vacío, el frontend opera en modo demostración/desconectado de forma segura.
NEXT_PUBLIC_API_URL=

# Entorno de ejecución
NEXT_PUBLIC_APP_ENV=development
